{
  "name": "@url-shortener/infrastructure",
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo .turbo",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@url-shortener/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
